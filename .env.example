# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง — .env ไม่ถูกเก็บลง git
# แก้ค่าในบล็อกไหนก็ตาม ต้องรีสตาร์ท `bun run dev` เพราะ connection pool
# ถูกแคชไว้บน globalThis ระหว่างการ hot reload

# ── ฐานข้อมูลหลักของ HIS (MariaDB) ────────────────────────────────
# เซิร์ฟเวอร์นี้เป็น tis620 ทั้งเครื่อง ตัวโปรแกรมกำหนด charset ให้เองแล้ว
HIS_HOST=192.168.0.10
HIS_PORT=3306
HIS_USER=readonly_user
HIS_PASSWORD=change-me
HIS_NAME=hos1

# ── ฐานข้อมูลภาพสแกน (MariaDB คนละเครื่องกับข้างบน) ──────────────
# ต้องใช้ชื่อตัวแปรคนละชุดกับบล็อกบน ไม่งั้นค่าล่างจะทับค่าบนทั้งหมด
HIS_SCAN_HOST=192.168.0.11
HIS_SCAN_PORT=3306
HIS_SCAN_USER=readonly_user
HIS_SCAN_PASSWORD=change-me
HIS_SCAN_NAME=hos_image

# ── สิทธิ์เข้าใช้ระบบตามตำแหน่ง/วิชาชีพ ───────────────────────────
# รหัสตำแหน่งที่อนุญาตให้เข้าระบบ คั่นด้วยจุลภาค เช่น 3,7,12
# เว้นว่าง = ไม่จำกัด ใครที่มีบัญชีก็เข้าได้
# ดูรหัสทั้งหมดจากฐาน core_kon:
#   SELECT user_position_id, position_name FROM user_positions ORDER BY user_position_id
# แก้แล้วต้องรีสตาร์ทเซิร์ฟเวอร์ และผู้ที่ล็อกอินค้างอยู่จะถูกตัดออกทันทีที่เปิดหน้าใหม่
ALLOWED_USER_POSITION_IDS=

# ── Health Rider (ส่งยาถึงบ้าน) ───────────────────────────────────
# รหัสอำเภอ 4 หลัก (จังหวัด 2 + อำเภอ 2) ที่โรงพยาบาลรับผิดชอบส่งยา
# ใช้จำกัดรายชื่อตำบลในหน้าจัดการพื้นที่ ไม่ให้ขึ้นตำบลทั้งประเทศ
# ดูรหัสได้จาก: SELECT addressid, name FROM thaiaddress WHERE codetype = '2'
HEALTH_RIDER_AMPHUR_ID=

# รหัสค่าบริการจัดส่งยาไปยังผู้ป่วยที่บ้าน (คอลัมน์ icode ในตาราง opitemrece)
# ใช้หารายชื่อผู้ป่วยที่ต้องส่งยาในแต่ละวัน เป็นรหัสเฉพาะของแต่ละโรงพยาบาล
# ดูรหัสได้จาก: SELECT icode, name FROM nondrugitems WHERE name LIKE '%จัดส่งยา%'
HIS_ICODE_DRUG_DELIVERY=

# ── รหัสรายการตรวจในตาราง lab_items ──────────────────────────────
# ค่าเฉพาะของแต่ละโรงพยาบาล ไม่ใช่ค่ามาตรฐาน — โรงพยาบาลอื่นที่ใช้ HIS
# ตัวเดียวกันรหัสก็ไม่ตรงกัน จึงไม่เขียนค่าจริงไว้ในไฟล์ตัวอย่างนี้
# หารหัสของโรงพยาบาลได้จาก:
#   SELECT lab_items_code, lab_items_name FROM lab_items
#   WHERE lab_items_name LIKE '%Creatinine%'
HIS_LAB_CODE_CREATININE=
HIS_LAB_CODE_EGFR=
HIS_LAB_CODE_HLA_B5801=

# ── กุญแจเซ็น JWT ────────────────────────────────────────────────
# สุ่มค่าใหม่ต่อระบบ ห้ามใช้ค่าตัวอย่างนี้ เช่น `openssl rand -base64 48`
JWT_SECRET=generate-a-long-random-string

# ── ฐานข้อมูลผู้ใช้งาน CoreKon (PostgreSQL) ──────────────────────
CORE_KON_HOST=192.168.0.12
CORE_KON_PORT=5432
CORE_KON_USER=postgres
CORE_KON_PASSWORD=change-me
CORE_KON_DB_NAME=hris
CORE_KON_SCHEMA=core_kon

# ── หมอพร้อม (ส่งรหัส OTP ตอนยืนยันตัวตนสองชั้น) ──────────────────
MOPH_ALERT_BASE_URL=https://morpromt2c.moph.go.th
MOPH_ALERT_CLIENT_ID=your-client-id
MOPH_ALERT_SECRET_ID=your-secret-id
